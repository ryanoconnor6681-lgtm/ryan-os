{
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "curio.help" }],
      "destination": "/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "www.curio.help" }],
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "curio.help" }],
      "destination": "/curio-site/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.curio.help" }],
      "destination": "/curio-site/index.html"
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "curio.help" }],
      "destination": "/curio-site/:path+"
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.curio.help" }],
      "destination": "/curio-site/:path+"
    }
  ]
}
